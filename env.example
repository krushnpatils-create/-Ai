# Copy to .env for local use. Never commit .env.
# Provider: "anthropic" (default) or "openai" (any OpenAI-compatible API)
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
# OpenAI / compatible
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults: claude-sonnet-5-5 (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
# Optional. Max tokens per reply (default 2048)
AI_MAX_TOKENS=2048
